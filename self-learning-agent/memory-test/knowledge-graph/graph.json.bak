      "label": "SESSION_ID",
      "category": "param",
      "summary": "会话标识常量。history-test2.mjs 硬编码为 'user_session_001'，仅用于演示单会话；多会话场景应该用动态值（如 req.session.id）。",
      "impl_file": "src/history-test2.mjs",
      "impl_lines": "19",
      "api": "const sessionId = 'user_session_001';"
    }
